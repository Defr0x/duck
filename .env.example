# Необязательные переменные окружения (файл .env не обязателен — всё работает и без него)

# Постоянный ключ сессий. Если не задан, используется значение из app.py.
SECRET_KEY=change-me-to-a-long-random-string

# Где слушать сервер
HOST=127.0.0.1
PORT=5000
# 1 — режим отладки (только для локальной разработки)
FLASK_DEBUG=0

# Локальная нейросеть (по умолчанию Qwen2.5-0.5B-Instruct, ~400 МБ)
# MODEL_PATH=/полный/путь/к/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
# MODEL_REPO=bartowski/Qwen2.5-0.5B-Instruct-GGUF
# MODEL_FILE=Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
